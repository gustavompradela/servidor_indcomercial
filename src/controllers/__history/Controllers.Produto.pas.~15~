unit Controllers.Produto;

interface

uses Horse;

procedure RegistrarRota;

implementation

uses Services.Produto;

procedure ListarProdutos(Req: THorseRequest; Res: ThorseResponse; Next: TProc);
var
  LService: TServiceProduto;
begin
  LService := TServiceProduto.Create(nil);
  try
    Res.Send('');
  finally
     LService.Free;
  end;
end;

